executable = run_batch_compare.sh

groups_file = batch_compare_groups.txt
data_input_override =
output_prefix =

output = logs/job_$(job_tag).out
error  = logs/job_$(job_tag).err
log    = logs/job_$(job_tag).log

+JobFlavour = "tomorrow"

request_cpus = 4
request_memory = 12000

arguments = $(group_tag) $(version_start) $(version_end) $(skip_version) $(draw_only) $(version_token) $(data_input_override) $(output_prefix)

queue group_tag, version_start, version_end, skip_version, draw_only, version_token, job_tag from $(groups_file)
