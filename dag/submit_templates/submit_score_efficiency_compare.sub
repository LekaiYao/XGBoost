universe = vanilla
executable = run_score_efficiency_compare.sh
arguments = $(comparison_tag) $(train_tag_a) $(train_tag_b)

output = logs/job_$(comparison_tag).out
error = logs/job_$(comparison_tag).err
log = logs/job_$(comparison_tag).log

getenv = True
request_cpus = 1
request_memory = 2000MB
request_disk = 1GB
+JobFlavour = "longlunch"

queue 1
