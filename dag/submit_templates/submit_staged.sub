executable = run_staged.sh

optuna_n_trials = 200
resume_flag = 0

output = logs/job_$(train_tag).out
error  = logs/job_$(train_tag).err
log    = logs/job_$(train_tag).log

+JobFlavour = "tomorrow"

request_cpus = 4
request_memory = 12000

arguments = $(train_tag) $(optuna_n_trials) $(stage_group) $(resume_flag)

queue train_tag, stage_group from (
  pb23v5_4v2_4o200_2v1 2v1
